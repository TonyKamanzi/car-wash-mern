# Node modules (always exclude this)
node_modules/

# Environment variables (never commit .env with secrets)
.env

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
Thumbs.db

# Build output (if you have any build step)
dist/
build/

# Optional: IDE/editor config files (VSCode, etc.)
.vscode/
.idea/

# Optional: coverage reports if you use testing tools
coverage/

# Optional: dependency directories for other package managers
.pnp/
.pnp.js
